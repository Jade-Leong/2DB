# Copy to .env in this folder, then fill these in privately and restart Loop Market.
# Leave blank to keep voice support unavailable; the form still works.
# Never use VITE_ prefixes for these values.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Supabase backend (server only). Copy the Session pooler URI from Connect.
SUPABASE_URL=https://jcynpdtvuqrppkkgegbt.supabase.co
SUPABASE_DB_URL=

# Use supabase after importing local data; tests always use isolated SQLite.
MARKET_DATABASE=sqlite
SUPABASE_DB_CA_FILE=

# Supabase Auth for email/password login and open sign-up in the 2db workspace.
# Use the publishable key, never a service-role or secret key.
SUPABASE_PUBLISHABLE_KEY=

# 2DB Bridge GitHub App (server only).
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_TOKEN_KEY=
GITHUB_APP_PUBLIC_URL=
GITHUB_APP_RETURN_URL=https://twodb-steel.vercel.app/control/
PROPOSAL_TARGET_REPO=
