{
  "name": "loop-market",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "vercel-build": "npm run build && node deployment/vercel/prepare-public.mjs",
    "start": "tsx server/index.ts",
    "reset": "tsx server/reset.ts",
    "test:smoke": "playwright test --project=smoke",
    "test:acceptance": "playwright test --project=acceptance",
    "test": "playwright test",
    "control": "tsx control/index.ts",
    "control:engineer": "node control/engineer.mjs",
    "control:check": "tsc --noEmit -p control/tsconfig.json",
    "control:test": "node --import tsx --test --test-concurrency=1 control/tests/controller.test.ts",
    "control:agent:status": "tsx control/agent/cli.ts status",
    "control:agent:prepare": "tsx control/agent/cli.ts prepare",
    "control:agent:test": "node --import tsx --test --test-concurrency=1 control/tests/agent.test.ts",
    "test:support": "node --import tsx --test verification/voice-api.test.ts && playwright test --project=support",
    "supabase:check": "node scripts/supabase.mjs check",
    "supabase:setup": "node scripts/supabase.mjs setup"
  },
  "dependencies": {
    "@elevenlabs/client": "^1.25.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@openai/codex-sdk": "0.154.0",
    "@vercel/sandbox": "3.3.0",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "pg": "^8.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
