{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "deployment/vercel/public",
  "functions": {
    "deployment/vercel/api/index.mjs": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/login",
      "destination": "/control/index.html"
    },
    {
      "source": "/signup",
      "destination": "/control/index.html"
    },
    {
      "source": "/api/:path*",
      "destination": "/deployment/vercel/api/index"
    },
    {
      "source": "/engineer-api/:path*",
      "destination": "/deployment/vercel/api/index"
    },
    {
      "source": "/auth-api/:path*",
      "destination": "/deployment/vercel/api/index"
    },
    {
      "source": "/uploads/:path*",
      "destination": "/deployment/vercel/api/index"
    }
  ]
}
